# Copy to ~/.config/film-kit/env (outside the repository) and fill in. Never commit a key.
FILM_VIDEO_BASE_URL=https://gateway.libraos.com/v1
FILM_IMAGE_BASE_URL=https://gateway.libraos.com/v1
FILM_VIDEO_KEY_FILE=~/.config/film-kit/key
FILM_VIDEO_MODEL=minimax-h3
FILM_IMAGE_MODEL=gpt-image-2.6
FILM_SIZE=896x512
# FILM_FFMPEG=/path/to/ffmpeg     if ffmpeg is not on PATH
# FILM_MUSIC_DIR=~/film-kit/music   instrumental scores (flac/wav/mp3), each with an optional NAME.txt note
